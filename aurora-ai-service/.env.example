# ============================================================
# AuroraAI — Environment Variables
# Copy this to .env and fill in your values
# ============================================================

# Shared PostgreSQL DB (same DB as ZenithBank — read-only user)
DATABASE_URL=postgresql://zenithbank_readonly:changeme@localhost:5432/zenithbank_banking

# Ollama — local LLM (primary)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Claude API — fallback if Ollama is unavailable
ANTHROPIC_API_KEY=your_anthropic_api_key_here
CLAUDE_MODEL=claude-3-haiku-20240307

# Which backend to use: ollama | claude
LLM_BACKEND=ollama

# App
APP_PORT=8000
DEBUG=false
