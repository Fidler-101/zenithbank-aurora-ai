# Copy this file to .env in the same folder as docker-compose.yml,
# fill in real values, and make sure .env is in your .gitignore.
# docker-compose reads this automatically with --env-file .env

# ---- Database ----
DB_USER=zenithbank_user
DB_PASSWORD=CHANGE_ME_use_a_real_password

# ---- Redis ----
REDIS_PASSWORD=CHANGE_ME_use_a_real_password

# ---- Email (customer-service OTP delivery) ----
# Gmail: use an App Password, not your real account password
# https://myaccount.google.com/apppasswords
SMTP_EMAIL=
SMTP_APP_PASSWORD=

# ---- Aurora AI ----
LLM_BACKEND=ollama
OLLAMA_BASE_URL=http://host.docker.internal:11434
ANTHROPIC_API_KEY=
